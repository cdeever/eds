// Voice Request: an album played because someone asked for it out loud.
// Drawn by GraphViz: `make -C docs diagrams` writes the .svg beside this
// file, and both are committed. Styles are the whole-system picture's
// (../system.dot); keep them alike. Change this when a component of the
// subsystem is added, moved or retired.
digraph voice_request {
    graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.3, ranksep=0.6,
           fontname="Helvetica,Arial,sans-serif", fontsize=13, newrank=true];
    node  [shape=box, style="rounded,filled", fillcolor="white", color="#5b6470",
           fontname="Helvetica,Arial,sans-serif", fontsize=11, margin="0.14,0.08"];
    edge  [color="#5b6470", fontname="Helvetica,Arial,sans-serif", fontsize=9,
           fontcolor="#3a4048", arrowsize=0.7];
    broker [label="MQTT broker\nmqtt01", shape=cylinder, fillcolor="#cfe9d8", margin="0.2,0.15"];

    subgraph cluster_room {
        label="Wherever it is · IoT, VLAN 30"; labeljust=l; style="rounded,filled"; fillcolor="#fdeeee"; color="#d9a3a3";
        ears [label="Ears · reSpeaker Lite\nXIAO ESP32-S3\nhears its wake word itself", fillcolor="#f8d2d2"];
    }

    subgraph cluster_workload {
        label="Services workload"; labeljust=l; style="rounded,filled"; fillcolor="#fff8e1"; color="#d6c06a";
        voiced  [label="voiced\nwords become play_album", fillcolor="#fdecb0"];
        scribe  [label="scribe\na WAV in, words out\nfaster-whisper", fillcolor="#fdecb0"];
        library [label="library index\nthe owner's iTunes library"];
    }

    musicbrainz [label="MusicBrainz\nan artist's albums, counted", fillcolor="#f4f4f4", color="#9aa1aa"];
    nowplaying  [label="Now Playing\nnowplayd, then the iTunes driver", style="rounded,dashed", color="#9aa1aa"];

    ears   -> broker [label="woken · the request, as a WAV\nwhat was heard, back", dir=both];
    broker -> voiced [label="utterance, woken in\nplay_album, duck, heard out", dir=both];
    voiced -> scribe [label="HTTP", dir=both];
    voiced -> library;
    voiced -> musicbrainz [label="the Nth album"];
    broker -> nowplaying [label="nowplaying/command"];
}
