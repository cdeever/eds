// EdS as a system of subsystems. Drawn by GraphViz:
//
//   make -C docs diagrams
//
// writes system.svg beside this file, and both are committed: the site is
// built by Hugo alone, which does not run dot.
//
// One box per subsystem, naming its components; each subsystem's own page
// has the detailed picture. Change this when a subsystem is added or a
// component moves between them. Every MQTT line is drawn to the broker,
// because that is where it goes: no subsystem talks to another directly.
digraph eds {
    graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.8,
           fontname="Helvetica,Arial,sans-serif", fontsize=13, newrank=true];
    node  [shape=box, style="rounded,filled", fillcolor="white", color="#5b6470",
           fontname="Helvetica,Arial,sans-serif", fontsize=11, margin="0.16,0.1"];
    edge  [color="#5b6470", fontname="Helvetica,Arial,sans-serif", fontsize=9,
           fontcolor="#3a4048", arrowsize=0.7];

    // ---- where the music comes from --------------------------------------
    subgraph cluster_music {
        label="The music"; labeljust=l; style="rounded,filled"; fillcolor="#fdf3e3"; color="#d9b77a";
        turntable [label="Turntable\nheard from the house's S/PDIF,\nits power seen by a beacon", fillcolor="#fbe2b6"];
        players   [label="iTunes · Spotify\nasked, by pairing and Web API", fillcolor="#e6d9f5"];
    }

    // ---- the subsystems ---------------------------------------------------
    nowplaying [label=<<b>Now Playing</b><br/><font point-size="10">drivers · recognizer · power beacon · nowplayd</font><br/><br/><i>what is playing, decided once</i>>, fillcolor="#fdecb0"];
    lightshow  [label=<<b>LP Light Show</b><br/><font point-size="10">lightd · palette · LP stand</font><br/><br/><i>the jacket lit in its own colors</i>>, fillcolor="#f8d2d2"];
    display    [label=<<b>Remote Display</b><br/><font point-size="10">cover screen</font><br/><br/><i>the cover, and five buttons</i>>, fillcolor="#f8d2d2"];
    voice      [label=<<b>Voice Request</b><br/><font point-size="10">ears · voiced · scribe · library index</font><br/><br/><i>an album asked for out loud</i>>, fillcolor="#f8d2d2"];

    // ---- the foundation ---------------------------------------------------
    subgraph cluster_foundation {
        label="Foundation"; labeljust=l; style="rounded,filled"; fillcolor="#eef7f1"; color="#8fbf9f";
        broker  [label="MQTT broker\nmqtt01 · Deevnet IoTaaS\n\neverything meets here", shape=cylinder, fillcolor="#cfe9d8", margin="0.25,0.2", fontsize=12];
        console [label="console\nshows it all; switches\nthe stand for every source"];
        ops     [label="eds-ota · log store · counts\nupdates, events, outside calls"];
    }

    outside [label="Outside services\nShazam · Discogs · Deezer\niTunes · MusicBrainz · Spotify", fillcolor="#f4f4f4", color="#9aa1aa"];

    { rank=same; lightshow; display; voice; }
    { rank=same; console; ops; }

    turntable  -> nowplaying [label="sound, power", style=bold, color="#2f5d8f", fontcolor="#24476d", penwidth=1.6];
    players    -> nowplaying [label="what plays\ncommands", dir=both];
    nowplaying -> outside    [label="names, records, covers"];
    nowplaying -> broker     [label="current · cover · look\ncommands in", dir=both, penwidth=1.6];

    broker -> lightshow [label="cover · look"];
    broker -> display   [label="current · small cover\ncommands back", dir=both];
    voice  -> broker    [label="play_album · duck"];
    voice  -> outside   [label="an artist's albums", constraint=false, style=dashed];

    broker -> console;
    broker -> ops [style=dotted];
}
