// LP Light Show: a record's cover becomes the light on its stand.
// Drawn by GraphViz: `make -C docs diagrams` writes the .svg beside this
// file, and both are committed. Styles are the whole-system picture's
// (../system.dot); keep them alike. Change this when a component of the
// subsystem is added, moved or retired.
digraph lp_light_show {
    graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.3, ranksep=0.6,
           fontname="Helvetica,Arial,sans-serif", fontsize=13, newrank=true];
    node  [shape=box, style="rounded,filled", fillcolor="white", color="#5b6470",
           fontname="Helvetica,Arial,sans-serif", fontsize=11, margin="0.14,0.08"];
    edge  [color="#5b6470", fontname="Helvetica,Arial,sans-serif", fontsize=9,
           fontcolor="#3a4048", arrowsize=0.7];
    broker [label="MQTT broker\nmqtt01", shape=cylinder, fillcolor="#cfe9d8", margin="0.2,0.15"];

    nowplaying [label="Now Playing\nthe cover, and its look", style="rounded,dashed", color="#9aa1aa"];
    console    [label="console\nrecords only, or every source", style="rounded,dashed", color="#9aa1aa"];

    subgraph cluster_workload {
        label="Services workload"; labeljust=l; style="rounded,filled"; fillcolor="#fff8e1"; color="#d6c06a";
        lightd  [label="lightd\nswatches become a scene\nfit for a strip", fillcolor="#fdecb0"];
        palette [label="palette\nimage bytes in\nperceptual colors out", fillcolor="#fdecb0"];
    }

    subgraph cluster_room {
        label="The vinyl listening room · IoT, VLAN 30"; labeljust=l; style="rounded,filled"; fillcolor="#fdeeee"; color="#d9a3a3";
        stand [label="LP stand\nESP32 · 18 LEDs\nrenders the scene itself,\napplies its own gamma", fillcolor="#f8d2d2"];
    }

    nowplaying -> broker [label="cover · look"];
    console    -> broker [label="the stand's setting"];
    broker     -> lightd [label="cover in\nscene out", dir=both];
    lightd     -> palette [label="HTTP", dir=both];
    broker     -> stand  [label="scene, retained"];
    stand      -> broker [label="what it shows\nonline, or its last will"];
}
