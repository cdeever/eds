// Remote Display: a screen that shows what plays, and can change it.
// Drawn by GraphViz: `make -C docs diagrams` writes the .svg beside this
// file, and both are committed. Styles are the whole-system picture's
// (../system.dot); keep them alike. Change this when a component of the
// subsystem is added, moved or retired.
digraph remote_display {
    graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.3, ranksep=0.6,
           fontname="Helvetica,Arial,sans-serif", fontsize=13, newrank=true];
    node  [shape=box, style="rounded,filled", fillcolor="white", color="#5b6470",
           fontname="Helvetica,Arial,sans-serif", fontsize=11, margin="0.14,0.08"];
    edge  [color="#5b6470", fontname="Helvetica,Arial,sans-serif", fontsize=9,
           fontcolor="#3a4048", arrowsize=0.7];
    broker [label="MQTT broker\nmqtt01", shape=cylinder, fillcolor="#cfe9d8", margin="0.2,0.15"];

    subgraph cluster_room {
        label="In the house · IoT, VLAN 30"; labeljust=l; style="rounded,filled"; fillcolor="#fdeeee"; color="#d9a3a3";
        screen [label="Cover screen\nESP32 · 320 x 240 touch\nthe cover, and five buttons", fillcolor="#f8d2d2"];
    }

    subgraph cluster_np {
        label="Now Playing"; labeljust=l; style="rounded,dashed"; color="#9aa1aa";
        nowplayd [label="nowplayd\npasses a command\nto the current source", fillcolor="#fdecb0"];
        driver   [label="the current source's driver\niTunes, or Spotify"];
    }
    player [label="the player\nplays, pauses, skips", fillcolor="#e6d9f5"];

    broker   -> screen   [label="current · small cover"];
    screen   -> broker   [label="a press, never retained", color="#2f5d8f", fontcolor="#24476d", penwidth=1.4];
    broker   -> nowplayd [label="nowplaying/command", dir=both];
    broker   -> driver   [label="source/<id>/command"];
    driver   -> player;
}
