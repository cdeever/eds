# Defaults that make a fresh checkout build into something that runs on the
# reSpeaker Lite's XIAO ESP32-S3: 8 MB of flash, 8 MB of octal PSRAM.
CONFIG_IDF_TARGET="esp32s3"

CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# A request is up to half a megabyte, kept in PSRAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y

# The XIAO's USB port is the chip's own USB serial: the console is there.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_HZ=1000

# Recover rather than sulk: an unattended device should come back on its own.
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y

# A new build that cannot reach the broker is given up (ADR-0035). This is
# the bootloader's, and the bootloader goes on only by cable: so from the
# first flash, before the updates that need it exist.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# A request is a few hundred kilobytes over a weak link (-80 dBm where the
# reSpeaker sits). lwIP's default send buffer, under 6 KB, held a 200 KB
# request to about 38 KB/s (CHG-0037); these let more be in flight.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=64
