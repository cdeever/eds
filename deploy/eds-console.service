[Unit]
Description=EdS console (container)
Wants=network-online.target
After=network-online.target

# kit.env names the broker and the tenant. It also carries lightd's login,
# which console-broker.env overrides with the console's own: a CONSOLE_*
# setting wins over the kit's name for the same thing.
#
# The console listens on ports 443 and 80 as a user who is not root. Binding
# ports that low is the one privilege it is given, and it is given by name.
#
# /opt/eds/tls holds its certificate and key, owned by the user the container
# runs as (65532, the image's nonroot) and readable by nobody else.
[Service]
Environment=IMAGE=localhost/eds-console:latest
ExecStartPre=-/usr/bin/podman rm -f eds-console
ExecStart=/usr/bin/podman run --rm --name eds-console --network host \
  --cap-drop=ALL --cap-add=NET_BIND_SERVICE --read-only \
  --env-file /opt/eds/kit.env --env-file /opt/eds/console.env --env-file /opt/eds/console-broker.env \
  -v /opt/eds/deevnet-root-ca.pem:/kit/deevnet-root-ca.pem:ro -e MQTT_CA_FILE=/kit/deevnet-root-ca.pem \
  -v /opt/eds/tls:/tls:ro \
  ${IMAGE}
ExecStop=/usr/bin/podman stop -t 5 eds-console
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
