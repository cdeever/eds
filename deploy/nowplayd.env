# nowplayd's own settings on the services workload. Not secret: its broker
# login is in nowplayd-broker.env, which is generated and never committed.
#
# Unique on the broker: it drops an older connection that reuses a client id.
NP_MQTT_CLIENT_ID=eds-nowplayd

# Spotify is reported and does not light the stand (ADR-0016): no cover is
# published for it, and none is looked up. Removing this line is what would
# make the stand follow Spotify.
NP_COVERLESS_SOURCES=spotify

# The turntable plays its owner's records, so what it reports is looked up in
# the owner's Discogs collection before any catalog (ADR-0022): the album is
# the record's own title and the cover its own sleeve. Whose collection, and
# the token that reads it, are in discogs.env, which is not committed.
NP_COLLECTION_SOURCES=turntable

# The turntable has a beacon on its switch (ADR-0023). While the beacon is
# connected the turntable is what is on, and holds the stand through its
# silences; while it is not, what the turntable's driver hears is not a
# record and is not reported. A beacon never heard from changes nothing.
NP_SOURCE_POWER=turntable=turntable-power-01

# A track left paused this long is no longer said to be playing: current goes
# to "stopped" with no track, and the cover topics are emptied, which is what
# dims the stand (ADR-0024). The source is still named, so play can be
# pressed. 0s is never.
NP_IDLE_AFTER=15s

# Nothing can skip a record or pause it, so a controller is told to offer
# nothing while the turntable is current (ADR-0025): the cover screen shows
# the sleeve and no buttons.
NP_NO_CONTROLS_SOURCES=turntable

# The same, for a source that is stopped and still current: the turntable,
# switched on, with nothing playing. Long enough to turn a record over.
NP_IDLE_AFTER_STOPPED=5m
