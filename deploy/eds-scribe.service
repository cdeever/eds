[Unit]
Description=EdS scribe (container)
Wants=network-online.target
After=network-online.target

# A spoken request in, its words out (ADR-0042). It reads no settings that
# matter and holds no secrets; the model is in the image, and is loaded as
# the service starts. It listens on 8733: palette has 8731 and lightd 8732,
# on the same host network.
#
# Its memory is bounded, because the workload is two gigabytes and the model
# a few hundred megabytes of it. Its share of the CPU is a quarter of the
# others': alone it has both cores, but when everything restarts at once,
# loading the model must not hold up the services connecting to the broker,
# which time out after ten seconds (CHG-0034). podman runs the container in a
# cgroup of its own, so the share is podman's flag, not the unit's CPUWeight.
[Service]
Environment=IMAGE=localhost/eds-scribe:latest
ExecStartPre=-/usr/bin/podman rm -f eds-scribe
ExecStart=/usr/bin/podman run --rm --name eds-scribe --network host --memory 900m --cpu-shares 256 ${IMAGE}
ExecStop=/usr/bin/podman stop -t 10 eds-scribe
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
