# lightd's own settings on the services workload. Not secret: the broker
# credentials come from kit.env. Anything here overrides kit.env.
#
# Unique on the broker: it drops an older connection that reuses a client id.
LIGHTD_MQTT_CLIENT_ID=eds-lightd

# The topic lightd lights the stand from, relative to the tenant's prefix:
# the current cover, which nowplayd publishes (ADR-0009). lightd sees image
# bytes there and nothing else. Its broker account must be granted it.
LIGHTD_COVER_TOPIC=nowplaying/current/art

# Beside each cover nowplayd says whether its album has a look of its own
# (ADR-0019). lightd sees a name and the hash of the cover it belongs to, and
# still nothing about tracks or albums. Its broker account must be granted it.
LIGHTD_LOOK_TOPIC=nowplaying/current/look

# How the `spectrum` look moves: `sweep` sends the whole rainbow around the
# strip; `morph` shows each color in turn, the whole strip at once.
LIGHTD_SPECTRUM_EFFECT=sweep

# The effect a cover is shown with. `chase` keeps the cover's dominant color
# as the ground and sends its accents around over it; `morph` turns the whole
# strip from one of the cover's colors to the next. Both need the stand's
# firmware to know them (CHG-0009); one that does not shows `solid`.
LIGHTD_EFFECT=chase
