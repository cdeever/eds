# lightd's own settings on the services workload. Not secret: the broker
# credentials come from kit.env. Anything here overrides kit.env.
#
# Unique on the broker: it drops an older connection that reuses a client id.
LIGHTD_MQTT_CLIENT_ID=eds-lightd

# The topic lightd lights the stand from, relative to the tenant's prefix:
# the current cover, which nowplayd publishes (ADR-0009). lightd sees image
# bytes there and nothing else. Its broker account must be granted it.
LIGHTD_COVER_TOPIC=nowplaying/current/art
