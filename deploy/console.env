# The console's own settings on the services workload. Not secret: its broker
# login is in console-broker.env, which is generated and never committed.
#
# Unique on the broker: it drops an older connection that reuses a client id.
CONSOLE_MQTT_CLIENT_ID=eds-console

# Port 443, so the page is a name and nothing after it; port 80 only sends
# people there. The workload's own firewall admits both (`make units` opens
# them); nothing off the site's trusted networks can reach a workload at all.
CONSOLE_ADDR=:80
CONSOLE_TLS_ADDR=:443

# The certificate with its chain, and its key, as the unit mounts them. They
# come from the tenant's state (`make tls-files`): the key is the tenant's
# own, and the certificate is the site's Tenant Service CA's (Deevnet
# ADR-0037). Neither is committed.
CONSOLE_TLS_CERT_FILE=/tls/console.crt
CONSOLE_TLS_KEY_FILE=/tls/console.key

# How many LEDs the stand's strip has, so the page draws that many. It is the
# firmware's LP_LED_COUNT, which nothing on the bus reports.
CONSOLE_STRIP_LEDS=18

# Where "Events in Grafana" goes.
CONSOLE_DASHBOARD_URL=https://grafana.mobile.deevnet.net/d/eds-lp-stand/lp-stand
