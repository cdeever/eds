# The console's own settings on the services workload. Not secret: its broker
# login is in console-broker.env, which is generated and never committed.
#
# Unique on the broker: it drops an older connection that reuses a client id.
CONSOLE_MQTT_CLIENT_ID=eds-console

# Port 80, so the page is a name and nothing after it. The workload's own
# firewall admits it (`make units` opens it); nothing off the site's trusted
# networks can reach a workload at all.
CONSOLE_ADDR=:80

# Where "Events in Grafana" goes.
CONSOLE_DASHBOARD_URL=https://grafana.mobile.deevnet.net/d/eds-lp-stand/lp-stand
