# consoled - the EdS console.
#
# A static binary on distroless, like lightd and nowplayd: no shell, no package
# manager, a non-root user. The page's files are compiled into the binary, so
# the image is the one file. Settings are all environment - see the README -
# and on Deevnet the broker's come from kit.env.
FROM docker.io/library/golang:1.25 AS build
ARG VERSION=dev
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X main.version=${VERSION}" -o /out/consoled ./cmd/consoled

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/consoled /consoled
EXPOSE 8080
ENTRYPOINT ["/consoled"]
