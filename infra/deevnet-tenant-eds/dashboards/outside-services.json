      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "deevnet-logs-devices"
          },
          "queryType": "statsRange",
          "expr": "event:=\"api.calls\" | stats by (api) sum(failed) failed",
          "legendFormat": "{{api}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "deevnet-logs-workloads"
          },
          "queryType": "statsRange",
          "expr": "event:=\"api.calls\" | stats by (api) sum(failed) failed",
          "legendFormat": "{{api}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Slowest call, by service",
      "description": "The slowest call in each minute. For the recognizer this is the whole of naming a clip, fingerprinting included.",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "showPoints": "always",
            "pointSize": 4
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "deevnet-logs-devices"
          },
          "queryType": "statsRange",
          "expr": "event:=\"api.calls\" | stats by (api) max(slowest_ms) slowest_ms",
          "legendFormat": "{{api}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "deevnet-logs-workloads"
          },
          "queryType": "statsRange",
          "expr": "event:=\"api.calls\" | stats by (api) max(slowest_ms) slowest_ms",
          "legendFormat": "{{api}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "What Discogs says is left",
      "description": "The least left of the allowance in each minute Discogs was asked anything.",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "deevnet-logs-workloads"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
