{
  "uid": "eds-outside-services",
  "title": "Outside Services",
  "tags": [
    "eds"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "panels": [
    {
      "type": "stat",
      "title": "Calls from the agent Pi",
      "description": "What the drivers asked of outside services in the selected period: the turntable's recognizer, and Spotify when its driver is on.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "deevnet-logs-devices"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "deevnet-logs-devices"
          },
          "queryType": "stats",
          "expr": "event:=\"api.calls\" | stats sum(calls) calls"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Calls from nowplayd",
      "description": "What nowplayd asked in the selected period: the owner's collection, and the catalogs covers are found in.",
      "gridPos": {
        "x": 5,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "deevnet-logs-workloads"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "deevnet-logs-workloads"
          },
          "queryType": "stats",
          "expr": "event:=\"api.calls\" | stats sum(calls) calls"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Refused for asking too often",
      "description": "Answers of 429 in the selected period, from the Pi and from nowplayd. Anything but none is a service saying EdS asked too much.",
      "gridPos": {
        "x": 10,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "deevnet-logs-devices"
          },
          "queryType": "stats",
          "expr": "event:=\"api.calls\" | stats sum(limited) limited"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "deevnet-logs-workloads"
          },
          "queryType": "stats",
          "expr": "event:=\"api.calls\" | stats sum(limited) limited"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Failed",
      "description": "Calls that reached nobody, or were answered with an error or a refusal, in the selected period.",
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "deevnet-logs-devices"
          },
          "queryType": "stats",
          "expr": "event:=\"api.calls\" | stats sum(failed) failed"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "deevnet-logs-workloads"
          },
          "queryType": "stats",
          "expr": "event:=\"api.calls\" | stats sum(failed) failed"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Least left of Discogs' allowance",
      "description": "The lowest Discogs said was left of its allowance of calls a minute, in the selected period. Sixty is untouched.",
      "gridPos": {
        "x": 19,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "deevnet-logs-workloads"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "deevnet-logs-workloads"
          },
          "queryType": "stats",
          "expr": "event:=\"api.calls\" api:=\"discogs\" | stats min(remaining) remaining"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "green",
                "value": 20
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Calls, by service",
      "description": "Each bar is what was asked in that stretch of time. A summary is written once a minute for each service that was asked anything; a minute with no calls writes nothing.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "deevnet-logs-devices"
          },
          "queryType": "statsRange",
          "expr": "event:=\"api.calls\" | stats by (api) sum(calls) calls",
          "legendFormat": "{{api}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "deevnet-logs-workloads"
          },
          "queryType": "statsRange",
          "expr": "event:=\"api.calls\" | stats by (api) sum(calls) calls",
          "legendFormat": "{{api}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Refused for asking too often, by service",
      "description": "429s. This should be empty.",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "datasource",
