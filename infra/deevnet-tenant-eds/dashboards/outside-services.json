          },
          "queryType": "statsRange",
          "expr": "event:=\"api.calls\" | stats by (api) sum(limited) limited",
          "legendFormat": "{{api}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "deevnet-logs-workloads"
          },
          "queryType": "statsRange",
          "expr": "event:=\"api.calls\" | stats by (api) sum(limited) limited",
          "legendFormat": "{{api}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Failed, by service",
      "description": "No answer, or an error or a refusal. A recognizer that cannot be reached shows here.",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
