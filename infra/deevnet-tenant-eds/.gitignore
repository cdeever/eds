# Terraform state is NOT committed. It lives in the substrate's state store
# (ADR-0007), which also gives locking that a repository cannot.
terraform.tfstate
terraform.tfstate.backup
.terraform/
*.tfplan
.terraform.tfstate.lock.info

# Issued by the substrate, not authored here - re-issue rather than commit.
fabric.auto.tfvars

# Never: the TSIG secret and the state credential arrive as environment
# variables, not files.
*.auto.tfvars
secrets.auto.tfvars
*.env

# Provider pins ARE committed (.terraform.lock.hcl is deliberately absent from
# this list): a module pinned by tag with providers left to float is half a
# pin, and the floating half is the dangerous one.
