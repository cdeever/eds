# Terraform state is NOT committed: it holds every credential the substrate
# issued this tenant (Deevnet ADR-0015 §4).
terraform.tfstate
terraform.tfstate.backup
.terraform/
*.tfplan
.terraform.tfstate.lock.info

# Issued at admission, never committed.
deevnet-root-ca.pem
deevnet-mobile-root-ca.pem
site-ca.pem

# A failed apply or destroy writes the state it could not persist here, and it
# holds the same credentials the state does.
errored.tfstate

# The lock file pins provider checksums, and until deevnet/deevnet is published
# or mirrored (Deevnet ADR-0012 §7) the only source is a locally built binary whose
# hash is nobody else's. It comes back with the mirror.
.terraform.lock.hcl
