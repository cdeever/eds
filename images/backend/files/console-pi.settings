# The console's settings on a backend Pi, where they differ from the
# workload's (deploy/console.env, which is read first).
#
# Its certificate is the card's one server certificate, which deevnet-kit
# issues for the broker, the log store and Grafana, and which names
# <hostname>.local. The kit issues no other (ADR-0033).
CONSOLE_TLS_CERT_FILE=/etc/deevnet-kit/tls/server.pem
CONSOLE_TLS_KEY_FILE=/etc/deevnet-kit/tls/server-key.pem
# No dashboard to link to until the tenant's are applied to this Pi's Grafana.
CONSOLE_DASHBOARD_URL=
