# Puts EdS's dashboards in this Pi's Grafana, after tenant2backend has given it
# the tenant's organization and log data sources. Every boot: it writes only
# what differs, and puts back a dashboard changed by hand.
[Unit]
Description=EdS backend: dashboards
# Either name of the base's tool (Deevnet ADR-0045); a missing unit is ignored.
ConditionPathExists=|/etc/backend/kit.json
ConditionPathExists=|/etc/deevnet-kit/kit.json
Wants=backend-dashboards.service deevnet-kit-dashboards.service
After=backend-dashboards.service deevnet-kit-dashboards.service grafana.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/eds-backend-dashboards

[Install]
WantedBy=multi-user.target
