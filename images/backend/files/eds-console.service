# EdS console on a backend Pi: the page a person looks at.
#
# It only looks (ADR-0018). It serves plain HTTP on loopback; nginx presents
# the card's certificate on 443 and passes the page here (ADR-0040).
[Unit]
Description=EdS console
Documentation=https://github.com/cdeever/eds/tree/main/services/console
After=network-online.target mosquitto.service eds-backend-setup.service
Wants=network-online.target
ConditionPathExists=/etc/eds/console.env

[Service]
User=eds-console
Group=eds-console
# In this order: a later file's settings win.
EnvironmentFile=/etc/eds/settings/console.env
EnvironmentFile=/etc/eds/settings/console-pi.env
EnvironmentFile=/etc/eds/console.env
ExecStart=/usr/local/bin/consoled
Restart=on-failure
RestartSec=10

# No privilege at all: its port is above 1024 and on loopback.
CapabilityBoundingSet=
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
