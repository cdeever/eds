# EdS console on a backend Pi: the page a person looks at.
#
# It only looks (ADR-0018). It serves the card's own server certificate on
# 443, and on 80 only sends people there. That certificate is read once, when
# the console starts: after `deevnet-kit regen-certs`, restart this unit.
[Unit]
Description=EdS console
Documentation=https://github.com/cdeever/eds/tree/main/services/console
After=network-online.target mosquitto.service eds-backend-setup.service
Wants=network-online.target
ConditionPathExists=/etc/eds/console.env

[Service]
User=eds-console
Group=eds-console
# The group that may read the server certificate's key.
SupplementaryGroups=deevnet-kit
# In this order: a later file's settings win.
EnvironmentFile=/etc/eds/settings/console.env
EnvironmentFile=/etc/eds/settings/console-pi.env
EnvironmentFile=/etc/eds/console.env
ExecStart=/usr/local/bin/consoled
Restart=on-failure
RestartSec=10

# Ports 80 and 443, and no other privilege.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
