# This card's own SSH host keys, made on its first boot.
#
# The build deletes the keys the image was built with, so no two cards - and no
# card and the build machine - present the same SSH identity. Raspberry Pi OS
# has its own regeneration unit, but whether it is still armed after the image
# build is not something this card relies on.
[Unit]
Description=EdS agent SSH host keys (first boot)
ConditionPathExists=!/etc/ssh/ssh_host_ed25519_key
Before=ssh.service sshd.service

[Service]
Type=oneshot
ExecStart=/usr/bin/ssh-keygen -A

[Install]
WantedBy=multi-user.target
