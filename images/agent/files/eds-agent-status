#!/bin/bash
# eds-agent-status - is each part of this agent Pi where it should be?
#
# A card with a second leg (a relay) is checked on both; one without is told
# so and not failed for it.
#
# Prints what it finds and exits non-zero if anything is wrong, so it serves
# as a check as well as a look.
bad=0
ok()   { printf '  ok    %s\n' "$*"; }
fail() { printf '  FAIL  %s\n' "$*"; bad=1; }
note() { printf '        %s\n' "$*"; }

env_value() { sudo grep -m1 -E "^$1=" /etc/eds/npagent.env 2>/dev/null | cut -d= -f2-; }

echo "$(hostname): Deevnet side (eth0)"
if ip -4 -o addr show eth0 2>/dev/null | grep -q inet; then
    ok "address $(ip -4 -o addr show eth0 | awk '{print $4}')"
else
    fail "eth0 has no address"
fi
if ip route show default | grep -q 'dev eth0'; then ok "default route is on eth0"; else fail "default route is not on eth0: $(ip route show default | head -1)"; fi

echo "Second leg (wlan0)"
if ! sudo test -f /etc/NetworkManager/system-connections/eds-home.nmconnection; then
    note "none configured: this card has its wired leg only"
else
    if ip -4 -o addr show wlan0 2>/dev/null | grep -q inet; then
        ok "address $(ip -4 -o addr show wlan0 | awk '{print $4}') on '$(nmcli -g GENERAL.CONNECTION device show wlan0 2>/dev/null)'"
    else
        fail "wlan0 has no address (journalctl -u eds-agent-import; nmcli device)"
    fi
fi
if ip route show default | grep -q 'dev wlan0'; then fail "wlan0 carries a default route"; else ok "no default route on wlan0"; fi

echo "Not a router"
[[ "$(cat /proc/sys/net/ipv4/ip_forward)" == "0" ]] && ok "forwarding is off" || fail "forwarding is ON"
if sudo nft list chain inet eds_agent forward 2>/dev/null | grep -q 'policy drop'; then ok "firewall drops forwarded packets"; else fail "firewall is not loaded"; fi

echo "Broker"
url="$(env_value NP_MQTT_URL)"
if [[ -z "$url" ]]; then
    fail "no agent settings in /etc/eds/npagent.env"
else
    hostport="${url#*://}"; host="${hostport%:*}"; port="${hostport##*:}"
    if timeout 5 bash -c "</dev/tcp/$host/$port" 2>/dev/null; then ok "$host:$port reachable"; else fail "$host:$port not reachable"; fi
    [[ -s /etc/eds/deevnet-root-ca.pem ]] && ok "broker CA present" || fail "broker CA missing"
fi

# A driver that was never set up is noted, not failed: a card may be here for
# one player only. One that was set up and is not working is a failure.
drivers="$(env_value NP_DRIVERS)"; drivers="${drivers:-itunes,spotify}"
configured=0

if [[ ",$drivers," == *",itunes,"* ]]; then
    echo "iTunes"
    pairing=/var/lib/eds-npagent/itunes-pairing.json
    if sudo test -s "$pairing"; then
        configured=1
        phost="$(sudo grep -o '"host": *"[^"]*"' "$pairing" | cut -d'"' -f4)"
        ok "paired with $phost"
        if timeout 5 bash -c "</dev/tcp/$phost/3689" 2>/dev/null; then ok "$phost:3689 reachable"; else fail "$phost:3689 not reachable"; fi
    else
        note "not paired: eds-agent-pair"
    fi
fi

if [[ ",$drivers," == *",spotify,"* ]]; then
    echo "Spotify"
    token=/var/lib/eds-npagent/spotify-token.json
    if sudo test -s "$token"; then
        configured=1
        # The date only. Nothing else in that file is for showing.
        granted="$(sudo grep -o '"authorized_at": *"[^"]*"' "$token" | cut -d'"' -f4 | cut -c1-10)"
        ends="$(date -u -d "$granted + 180 days" +%Y-%m-%d 2>/dev/null)"
        left=$(( ( $(date -u -d "$ends" +%s 2>/dev/null || echo 0) - $(date -u +%s) ) / 86400 ))
        if (( left < 0 )); then fail "authorization ended $ends: authorize again (make spotify, on the desk)"
        elif (( left < 14 )); then ok "authorized until $ends - $left days left: authorize again soon"
        else ok "authorized until $ends"; fi

        if sudo test -s /etc/eds/npagent-spotify.env; then
            ok "devices that count: $(sudo grep -m1 '^NP_SPOTIFY_DEVICES=' /etc/eds/npagent-spotify.env | cut -d= -f2-)"
        else
            fail "no devices named, so no playback counts"
        fi
        if timeout 5 bash -c "</dev/tcp/api.spotify.com/443" 2>/dev/null; then ok "api.spotify.com:443 reachable"; else fail "api.spotify.com:443 not reachable"; fi
        # Spotify refusing is not something a port check shows.
        refused="$(sudo journalctl -u npagent -b --no-pager -o cat 2>/dev/null | grep 'driver=spotify' | tail -1 | grep -o 'spotify answered[^"]*' | cut -c1-110)"
        [[ -n "$refused" ]] && fail "$refused"
    else
        note "not authorized: make spotify, on the desk"
    fi
fi

if [[ ",$drivers," == *",turntable,"* ]]; then
    echo "Turntable"
    device="$(env_value NP_TURNTABLE_DEVICE)"
    if [[ -z "$device" ]]; then
        note "no input named: make turntable DEVICE=..., on the desk (arecord -L lists them)"
    else
        configured=1
        # plughw:UA4FX,0 and hw:UA4FX name the card UA4FX; "default" names none.
        card="${device#*:}"; card="${card%%,*}"
        if [[ "$device" != *:* ]]; then ok "listening to $device"
        elif [[ -e "/proc/asound/$card" ]]; then ok "listening to $device"
        else fail "$device is not plugged in (cards: $(awk -F'[][]' '/\[/{printf "%s ", $2}' /proc/asound/cards))"; fi
        if /opt/eds-recognize/bin/python -c 'import shazamio' 2>/dev/null; then ok "recogniser installed"; else fail "recogniser is not installed: eds-agent-turntable-install"; fi
        if timeout 5 bash -c "</dev/tcp/amp.shazam.com/443" 2>/dev/null; then ok "amp.shazam.com:443 reachable"; else fail "amp.shazam.com:443 not reachable"; fi
        failing="$(sudo journalctl -u npagent -b --no-pager -o cat 2>/dev/null | grep -E 'turntable\.(recognizer_failed|recognizer_back|capture_lost)' | tail -1)"
        [[ "$failing" == *recognizer_failed* || "$failing" == *capture_lost* ]] && fail "$(cut -c1-140 <<<"$failing")"
    fi
fi

(( configured )) || fail "no driver is set up"

echo "Agent"
if systemctl is-active --quiet npagent; then ok "npagent is running"; else fail "npagent is $(systemctl is-active npagent)"; fi
sudo journalctl -u npagent -n 3 --no-pager -o cat 2>/dev/null | cut -c1-150 | while read -r line; do note "$line"; done

exit $bad
